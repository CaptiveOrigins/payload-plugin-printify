{
  "name": "@captiveorigins/payload-plugin-printify",
  "version": "0.2.2",
  "description": "Printify for Payload: print-on-demand for Payload’s ecommerce plugin, with product sync, order fulfillment and tracking, and optional price write-back.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-printify#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-printify/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "printify",
    "ecommerce",
    "print-on-demand"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-printify.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node20",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "payload": "^3.60.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/plugin-ecommerce": "3.92.1",
    "@payloadcms/plugin-multi-tenant": "3.92.1",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "11.3.0",
    "payload": "3.92.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
